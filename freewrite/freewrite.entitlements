<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        App Sandbox is DISABLED. The LiveKit cloud client does region failover
        by opening WebSockets to per-region hostnames (*.<region>.production.
        livekit.cloud); under the sandbox those regional handshakes are
        cancelled/time out and connect fails with "Region manager error (No
        more remaining regions)". Cosmic (the proven macOS LiveKit client) is
        also non-sandboxed for the same reason. Freewrite ships via Developer ID
        (not the Mac App Store), so the sandbox isn't required.
    -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.speech-recognition</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
